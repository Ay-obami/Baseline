module Test.Math where

import Daml.Script
import BaseLine.Math

millionCents : Int
millionCents = 100000000

testMath : Script ()
testMath = script do
  assertMsg "20M at 8000 bps must contribute 16M" (creditContribution (20 * millionCents) 8000 == 16 * millionCents)
  assertMsg "10M at 8000 bps must contribute 8M" (creditContribution (10 * millionCents) 8000 == 8 * millionCents)
  assertMsg "one cent at 8000 bps must round down to zero" (creditContribution 1 8000 == 0)
  assertMsg "initial credit limit must be 40M" (creditLimit (40 * millionCents) (40 * millionCents) == 40 * millionCents)
  assertMsg "post-event credit limit must be 32M" (creditLimit (32 * millionCents) (40 * millionCents) == 32 * millionCents)
  assertMsg "initial signed headroom must be +5M" (signedHeadroom (40 * millionCents) (35 * millionCents) == 5 * millionCents)
  assertMsg "post-event signed headroom must be -3M" (signedHeadroom (32 * millionCents) (35 * millionCents) == -3 * millionCents)
  assertMsg "post-event deficiency must be 3M" (deficiency (32 * millionCents) (35 * millionCents) == 3 * millionCents)
